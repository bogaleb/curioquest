{
  "name": "curioquest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/test-supabase-db.mjs --integration",
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:test-live": "node scripts/test-supabase-live.mjs",
    "supabase:test-db": "node scripts/test-supabase-db.mjs",
    "supabase:types": "node scripts/test-supabase-db.mjs --write-types",
    "supabase:seed-generate": "node scripts/seed-supabase-curriculum.mjs",
    "supabase:import": "node scripts/import-legacy.mjs",
    "supabase:bundle": "node scripts/bundle-supabase-upgrade.mjs",
    "supabase:verify": "node scripts/verify-migrations.mjs",
    "mastery:rebuild": "node scripts/rebuild-mastery.mjs",
    "mastery:report": "node scripts/rebuild-mastery.mjs --report",
    "ui:shots": "node scripts/ui-shots.mjs",
    "ui:test-parent": "node scripts/make-test-parent.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
